# Supabase & Vercel Environment Variables
# Copy this file to .env.local in your Next.js project root and fill in your Supabase credentials.

# Supabase Project API Credentials
# Found in Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# App URL for OAuth redirects and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI Services
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
